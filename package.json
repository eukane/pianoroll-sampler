{
  "name": "pianoroll-sampler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-worklet": "node scripts/copy-worklet.mjs",
    "predev": "npm run copy-worklet",
    "dev": "vite",
    "prebuild": "npm run copy-worklet",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "smoke": "node scripts/smoke.mjs",
    "gen-fixture": "node scripts/gen-fixture.mjs",
    "presmoke": "npm run gen-fixture && npm run gen-samples",
    "midi": "node scripts/midi-roundtrip.mjs",
    "gen-samples": "node scripts/gen-samples.mjs",
    "names": "node scripts/samplename-test.mjs",
    "dev:https": "vite --mode https",
    "predev:https": "npm run copy-worklet",
    "built-check": "node scripts/built-check.mjs",
    "gen-big-sf2": "node --max-old-space-size=4096 scripts/gen-big-sf2.mjs",
    "audit": "node scripts/audit.mjs",
    "clipboard": "node scripts/clipboard-test.mjs",
    "latency": "node scripts/latency-probe.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "spessasynth_core": "^4.3.20",
    "spessasynth_lib": "^4.3.14"
  }
}
